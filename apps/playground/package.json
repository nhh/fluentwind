{
  "name": "@fluentwind/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:update-snapshots": "playwright test --config e2e/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@fluentwind/react": "workspace:*",
    "@fluentwind/tokens": "workspace:*",
    "react": "^18",
    "react-dom": "^18",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
